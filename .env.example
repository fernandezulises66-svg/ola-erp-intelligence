# Copiá este archivo como .env y completá las keys. El .env está en el .gitignore: nunca se sube.
# Todos los valores (modelos, índice, namespace, límites) se configuran acá: no hay nada hardcodeado.

# --- LLM ---
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# solo si tu key no está asociada a un workspace
ANTHROPIC_WORKSPACE_ID=
# si LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-6-luna

# --- RAG híbrido: BM25 local + Pinecone (embeddings de OpenAI) ---
# hybrid | bm25 (sin Pinecone ni OpenAI)
RAG_MODE=hybrid
PINECONE_API_KEY=pcsk_...
OPENAI_API_KEY=sk-...
# se crea solo si no existe
PINECONE_INDEX_NAME=ola-erp-docs
# el manual se sube solo la primera vez
PINECONE_NAMESPACE=intelligence-v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Redis y worker (con docker compose, REDIS_URL lo define el servicio "redis") ---
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=5

# --- Grafo de agentes ---
MAX_DELEGACIONES=6
RECURSION_LIMIT=40

# --- Observabilidad: Arize Phoenix (con docker compose, el endpoint lo define el servicio "phoenix") ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=ola-erp-intelligence
